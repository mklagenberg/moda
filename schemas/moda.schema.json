{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mklagenberg/moda/blob/main/schemas/moda.schema.json",
  "title": "MODA Manifest",
  "description": "Machine-readable identity and conformance declaration for a MODA artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["moda", "artifact", "adoption", "documentation", "components", "packages", "installations", "conformance", "synchronization"],
  "properties": {
    "moda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_version", "repository", "compatibility", "verified_against", "verified_commit"],
      "properties": {
        "manifest_version": {"const": "1.0"},
        "repository": {"type": "string", "format": "uri"},
        "compatibility": {"type": "string", "minLength": 1},
        "verified_against": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
        "verified_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "kind", "version", "status", "language", "repository", "license"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "full_name": {"type": "string"},
        "kind": {"enum": ["methodology", "framework"]},
        "domain": {"type": "string"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
        "status": {"enum": ["development", "active", "deprecated", "archived"]},
        "language": {"type": "string", "minLength": 2},
        "repository": {"type": "string", "format": "uri"},
        "license": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "mode", "claim_stage", "conformance_result"],
      "properties": {
        "relationship": {"enum": ["designed_with", "conforms_to", "audited_against", "inherited_via"]},
        "mode": {"enum": ["native", "retrospective"]},
        "claim_stage": {"enum": ["declared", "mapped", "verified", "certified"]},
        "conformance_result": {"enum": ["conformant", "partial", "nonconformant", "unknown"]}
      }
    },
    "documentation": {
      "type": "object",
      "required": ["human_entrypoint", "agent_entrypoint", "specification", "getting_started", "invariants", "changelog", "roadmap", "upgrade", "migrations", "decisions", "change_management", "git_workflow"],
      "additionalProperties": {"type": "string"}
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "lifecycle"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "source": {"type": "string"},
          "lifecycle": {"enum": ["embedded", "independent"]}
        },
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["role", "version", "source", "source_kind"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
          "source_kind": {"enum": ["local", "git"]},
          "source": {},
          "compatibility": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "installations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "environment", "version", "state"],
        "properties": {
          "package": {"type": "string"},
          "environment": {"type": "string"},
          "adapter": {"type": "string"},
          "version": {"type": "string"},
          "state": {"enum": ["current", "update-available", "security-update-required", "incompatible", "unknown", "offline"]}
        },
        "additionalProperties": true
      }
    },
    "conformance": {
      "type": "object",
      "required": ["profile", "latest_audit", "audit_mode"],
      "properties": {
        "profile": {"type": "string"},
        "latest_audit": {"type": "string"},
        "audit_mode": {"enum": ["self-audit", "independent-audit"]}
      },
      "additionalProperties": false
    },
    "synchronization": {
      "type": "object",
      "required": ["policy", "state", "reason"],
      "properties": {
        "policy": {"type": "string"},
        "state": {"enum": ["current", "review-required", "incompatible", "broken", "unknown"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
